# Copy to .env.local and fill in your values.

# --- Clerk (authentication) ---
# From the Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signing secret for the webhook at /api/webhooks/clerk (Endpoints -> Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# --- PostgreSQL (database) ---
# The yolo-service (Python backend on port 8000) connects to a hosted Postgres
# using this connection string. Either hosting provider works:

# Neon:  Create a project at https://neon.tech, copy the connection string from
#        the dashboard (it already includes ?sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# Supabase: Create a project at https://supabase.com, then Settings -> Database
#           -> Connection string -> "URI" (with the postgres password set).
# DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# --- AI service (optional) ---
# Where the frontend finds the yolo-service. Defaults to http://127.0.0.1:8000.
# NEXT_PUBLIC_YOLO_SERVICE_URL=http://127.0.0.1:8000
